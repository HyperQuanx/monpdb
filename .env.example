# Copy to .env.local for local overrides. Every VITE_* value is embedded in the
# public bundle, so never put secrets here.

# Backend API base URL for the HTTP repositories (Task 19). The web build
# currently runs on fixture repositories and does not call this API.
VITE_API_BASE_URL=https://qbix-portfolio.shop/api

# fixture (default): session samples. http: real API + persistent text read cache.
VITE_DATA_MODE=fixture
# Local HTTP development: VITE_API_BASE_URL=http://127.0.0.1:8181/api
